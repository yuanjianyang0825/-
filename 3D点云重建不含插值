""" 
reconstruct_3d.py 
矩形ROI匹配版 
ROI: 沿运动方向 ±90 pixel 垂直方向 ±2 pixel 
"""

import numpy as np
import imageio.v2 as imageio
from scipy.optimize import curve_fit
from scipy.ndimage import center_of_mass
from skimage.feature import peak_local_max
import matplotlib.pyplot as plt

# =====================================================
# 参数
# =====================================================
database_file = "spot_database.npz"
sample_file = r"C:\Users\A\Desktop\硬币超分辨图\19.bmp"
background_file = r"C:\Users\A\Desktop\硬币超分辨背景图\1.bmp"

roi_radius = 8
threshold_abs = 35
min_distance = 20

BAD_PIXELS = [
    (1207, 2750),
    (373, 2688)
]

TRACK_HALF_LENGTH = 50.0
TRACK_HALF_WIDTH = 1.2

# =====================================================
# 高斯拟合
# =====================================================
def gauss_1d(x, A, mu, sigma, B):
    return A * np.exp(-0.5 * ((x - mu) / sigma) ** 2) + B

def fit_gauss_center(line):
    x = np.arange(len(line), dtype=float)
    try:
        mu0 = np.sum(x * line) / np.sum(line)
        p0 = [line.max() - line.min(), mu0, 2.0, line.min()]
        p, _ = curve_fit(gauss_1d, x, line, p0=p0, maxfev=1000)
        return p[1]
    except:
        return center_of_mass(line)[0]

# =====================================================
# 数据库
# =====================================================
print("读取数据库...")
db = np.load(database_file, allow_pickle=True)

x_ref = db["x_ref"]
y_ref = db["y_ref"]
centers = db["centers"]
directions = db["directions"]
coeffs = db["coeffs"]
s_min = db["s_min"]
s_max = db["s_max"]
errors = db["errors"]
heights = db["heights"]

N = len(x_ref)
print(f"数据库光斑数: {N}")

# =====================================================
# 样品图
# =====================================================
print("读取样品图...")
img = imageio.imread(sample_file)
gray = img[:, :, 0].astype(np.float32)

print("读取背景图...")
bg = imageio.imread(background_file)
background = bg[:, :, 0].astype(np.float32)

for x, y in BAD_PIXELS:
    roi = gray[y-1:y+2, x-1:x+2]
    gray[y, x] = (np.sum(roi) - gray[y, x]) / 8

for x, y in BAD_PIXELS:
    roi = background[y-1:y+2, x-1:x+2]
    background[y, x] = (np.sum(roi) - background[y, x]) / 8

gray = gray - background
gray[gray < 0] = 0
H, W = gray.shape

# =====================================================
# 误差插值函数
# =====================================================

def interpolate_error(
        spot_index,
        z_raw,
        errors,
        heights
):

    err_curve = errors[spot_index]


    valid = np.isfinite(err_curve)

    h = heights[valid]
    e = err_curve[valid]


    if len(h) < 2:
        return 0


    # 超出标定范围
    if z_raw <= h.min():
        return e[np.argmin(h)]

    if z_raw >= h.max():
        return e[np.argmax(h)]


    # 线性插值
    error = np.interp(
        z_raw,
        h[::-1],
        e[::-1]
    )

    return error


# =====================================================
# 光斑检测
# =====================================================
print("检测光斑...")
coords = peak_local_max(gray, min_distance=min_distance, threshold_abs=threshold_abs)
print(f"检测到 {len(coords)} 个候选光斑")

xm = []
ym = []

print("亚像素定位...")
for y0, x0 in coords:
    y1 = max(int(y0) - roi_radius, 0)
    y2 = min(int(y0) + roi_radius + 1, H)
    x1 = max(int(x0) - roi_radius, 0)
    x2 = min(int(x0) + roi_radius + 1, W)
    
    roi = gray[y1:y2, x1:x2]
    if roi.size == 0:
        continue
        
    dx = fit_gauss_center(roi.sum(axis=0))
    dy = fit_gauss_center(roi.sum(axis=1))
    
    xm.append(x1 + dx)
    ym.append(y1 + dy)

xm = np.array(xm)
ym = np.array(ym)
M = len(xm)
print(f"有效光斑数: {M}")

# =====================================================
# 匹配
# =====================================================
print("开始匹配...")
matched = np.zeros(N, dtype=bool)
X=[]
Y=[]

Z_raw=[]
Z_correct=[]

# 调试信息
spot_id = []
sample_id = []
match_distance = []
success = 0

for k in range(N):
    cx, cy = centers[k]
    vx, vy = directions[k]
    
    nx = -vy
    ny = vx
    
    dx = xm - cx
    dy = ym - cy
    
    s = (dx * vx + dy * vy)
    d = (dx * nx + dy * ny)
    
    mask = ((np.abs(s) <= TRACK_HALF_LENGTH) & (np.abs(d) <= TRACK_HALF_WIDTH))
    idx = np.where(mask)[0]
    
    if len(idx) == 0:
        continue
        
    best = idx[np.argmin(np.abs(d[idx]))]
    d_best = np.abs(d[best])
    s_peak = s[best]
    
    coef = coeffs[k]


    # 原始高度
    z_raw = np.polyval(
        coef,
        s_peak
    )


    # ==========================
    # 高度误差补偿
    # ==========================
    spot_index = k
    error = interpolate_error(
        spot_index,
        z_raw,
        errors,
        heights
    )


    z_correct = z_raw + error



    X.append(
        x_ref[k]
    )

    Y.append(
        y_ref[k]
    )

    Z_correct.append(
        z_correct
    )

    Z_raw.append(
            z_raw
        )
    
    # 调试信息
    spot_id.append(k)
    sample_id.append(best)
    match_distance.append(d_best)
    
    matched[k] = True
    success += 1

    if (k + 1) % 1000 == 0:
        print(f"{k+1}/{N}")

# =====================================================
# 保存
# =====================================================
X = np.array(X)
Y = np.array(Y)
Z_raw=np.array(Z_raw)

Z_correct=np.array(Z_correct)

spot_id = np.array(spot_id)
sample_id = np.array(sample_id)
match_distance = np.array(match_distance)

cloud = np.column_stack([X, Y, Z_correct])
np.savetxt("point_cloud.xyz", cloud, fmt="%.6f")

np.savez(
    "reconstruct_debug.npz", 
    X=X, Y=Y, Z=Z_correct, Z_raw=Z_raw,
    spot_id=spot_id, sample_id=sample_id, match_distance=match_distance, 
    xm=xm, ym=ym
)

print()
print(f"匹配成功: {success}")
print(f"匹配率: {100*success/N:.2f}%")
print("已保存 point_cloud.xyz")

# =====================================================
# 点云显示
# =====================================================
fig = plt.figure(figsize=(10, 8))
ax = fig.add_subplot(111, projection='3d')
ax.scatter(X, Y, Z_correct, s=1) # 相比较修正前后可以改成z_raw

# 在 ax.scatter 之后添加：
# margin = 1  # 向外扩展的余量，可根据数据大小调整
# ax.set_xlim(X.min() - margin, X.max() + margin)
# ax.set_ylim(Y.min() - margin, Y.max() + margin)
# ax.set_zlim(Z.min() - margin, Z.max() + margin)

ax.set_xlabel("X")
ax.set_ylabel("Y")
ax.set_zlabel("Height(mm)")

plt.tight_layout()
plt.show()

# =============================================

print(
    "平均补偿量:",
    np.mean(
        Z_correct - Z_raw
    )*1000,
    "um"
)
print(
    "最大补偿量:",
    np.max(
        np.abs(
            Z_correct - Z_raw
        )
    )*1000,
    "um"
)
