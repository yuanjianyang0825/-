# =====================================================
# 样品图
# =====================================================


def reconstruct_one_frame(sample_file):



    img=imageio.imread(sample_file)
    gray=img[:,:,0].astype(np.float32)


    bg=imageio.imread(background_file)
    background=bg[:,:,0].astype(np.float32)

    for x,y in BAD_PIXELS:

        roi=gray[
            y-1:y+2,
            x-1:x+2
        ]

        gray[y,x]=(
            np.sum(roi)-gray[y,x]
        )/8

    for x,y in BAD_PIXELS:

        roi=background[
            y-1:y+2,
            x-1:x+2
        ]

        background[y,x]=(
            np.sum(roi)-background[y,x]
        )/8

    gray = gray - background

    gray[gray < 0] = 0

    H,W=gray.shape


    # =====================================================
    # 光斑检测
    # =====================================================


    coords=peak_local_max(
        gray,
        min_distance=min_distance,
        threshold_abs=threshold_abs
    )


    xm=[]
    ym=[]


    for y0,x0 in coords:

        y1=max(
            int(y0)-roi_radius,
            0
        )

        y2=min(
            int(y0)+roi_radius+1,
            H
        )

        x1=max(
            int(x0)-roi_radius,
            0
        )

        x2=min(
            int(x0)+roi_radius+1,
            W
        )

        roi=gray[
            y1:y2,
            x1:x2
        ]

        if roi.size==0:
            continue

        profile_x = roi.sum(axis=0)
        profile_y = roi.sum(axis=1)

        if PEAK_METHOD == "gaussian":

            dx = fit_gauss_center(profile_x)
            dy = fit_gauss_center(profile_y)

        elif PEAK_METHOD == "centroid":

            dx = fit_centroid(profile_x)
            dy = fit_centroid(profile_y)

        elif PEAK_METHOD == "local_centroid":

            dx = fit_local_centroid(
                profile_x,
                LOCAL_HALF_WIDTH
            )

            dy = fit_local_centroid(
                profile_y,
                LOCAL_HALF_WIDTH
            )

        else:

            raise ValueError(
                "Unknown PEAK_METHOD"
            )
        
        xm.append(
            x1+dx
        )

        ym.append(
            y1+dy
        )

    xm=np.array(xm)
    ym=np.array(ym)

    M=len(xm)



    # =====================================================
    # 匹配
    # =====================================================



    Z_detect = np.full(N, np.nan)

    X=[]
    Y=[]
    Z=[]

    # 调试信息
    spot_id=[]


    for k in range(N):

        cx,cy=centers[k]

        vx,vy=directions[k]

        nx=-vy
        ny=vx

        dx=xm-cx
        dy=ym-cy

        s=(
            dx*vx
            +
            dy*vy
        )

        d=(
            dx*nx
            +
            dy*ny
        )

        mask=(
            (np.abs(s)<=TRACK_HALF_LENGTH)
            &
            (np.abs(d)<=TRACK_HALF_WIDTH)
        )

        idx=np.where(mask)[0]

        if len(idx)==0:
            continue

        best=idx[
            np.argmin(
                np.abs(d[idx])
            )
        ]


        
        s_peak=s[best]

        coef=coeffs[k]

        z=np.polyval(
            coef,
            s_peak
        )

        Z_detect[k] = z

        X.append(
            x_ref[k]
        )

        Y.append(
            y_ref[k]
        )

        Z.append(z)

        # 调试信息
        spot_id.append(k)




    
    # =====================================================
    # 删除高度离群点
    # =====================================================

    OUTLIER_THRESHOLD = 0.7   # mm

    # 只统计有效点
    X=np.array(X)
    Y=np.array(Y)
    Z=np.array(Z)

    valid=np.isfinite(Z)

    # 使用中位数，比平均值稳定
    z_center = np.median(Z[valid])

    # 判断离群点
    spot_id = np.array(spot_id)

    outlier = np.abs(
        Z - z_center
    ) > OUTLIER_THRESHOLD

    print(f"检测到离群点：{np.sum(outlier)} 个")

    bad_index = spot_id[outlier]

    Z_detect[bad_index] = np.nan

    return Z_detect


X_total=[]

Y_total=[]

Z_total=[]

dx=-0.128

dy=-5.866

for frame in range(1,26):
    print(f"\n========== 正在处理第 {frame}/25 张图 ==========")
    sample_file=os.path.join(
    sample_folder,
    f"{frame}.bmp"
    )
    Z_frame = reconstruct_one_frame(sample_file)

    shift_x=(frame-1)*dx

    shift_y=(frame-1)*dy

    for k in range(N):

        if np.isnan(Z_frame[k]):
            continue

        X_total.append(
            x_ref[k]+shift_x
        )

        Y_total.append(
            y_ref[k]+shift_y
        )

        Z_total.append(
            Z_frame[k]
        )
    



X_total=np.array(X_total)

Y_total=np.array(Y_total)

Z_total=np.array(Z_total)



grid_x=[]

grid_y=[]



for frame in range(25):

    sx=frame*dx

    sy=frame*dy

    grid_x.append(
        x_ref+sx
    )

    grid_y.append(
        y_ref+sy
    )

grid_x=np.concatenate(grid_x)

grid_y=np.concatenate(grid_y)

tree=cKDTree(
np.column_stack(
(
X_total,
Y_total
)
)
)

grid_z=np.full(
    len(grid_x),
    np.nan
)

for i in range(len(grid_x)):

    pt=np.array([
        grid_x[i],
        grid_y[i]
    ])

    # 如果该位置本身就是测量点，直接使用真实高度
    d0, idx0 = tree.query(pt, k=1)

    if d0 < 1e-6:
        grid_z[i] = Z_total[idx0]
        continue

    dist,idx=tree.query(
        pt,
        k=IDW_NEIGHBORS,
        distance_upper_bound=IDW_RADIUS
    )

    dist=np.atleast_1d(dist)
    idx=np.atleast_1d(idx)

    valid=np.isfinite(dist)

    valid &= idx < len(Z_total)

    if np.sum(valid)==0:

        grid_z[i]=np.nan
        continue

    dist=dist[valid]
    idx=idx[valid]

    dist=np.maximum(
        dist,
        1e-6
    )

    w=1/dist**IDW_POWER

    w/=w.sum()

    grid_z[i]=np.sum(
        w*Z_total[idx]
    )



valid = np.isfinite(grid_z)

print("有效测量点:", len(Z_total))
print("超分辨点:", np.sum(valid))

cloud = np.column_stack((grid_x[valid], grid_y[valid], grid_z[valid]))
