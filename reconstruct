"""
reconstruct_3d_match_line.py

光谱共焦三维重构

方案：
样品图光斑检测
→ 最近轨迹匹配
→ 高度反解

输出：
point_cloud.xyz
"""

import numpy as np
import imageio.v2 as imageio

from scipy.optimize import curve_fit
from scipy.ndimage import center_of_mass

from skimage.feature import peak_local_max

import matplotlib.pyplot as plt


# =====================================================
# 配置
# =====================================================

database_file = "spot_database.npz"

sample_file = r"C:\Users\A\Desktop\a硬币数字面\2.bmp"

roi_radius = 8

threshold_abs = 30
min_distance = 20

BAD_PIXELS = [
    (1207,2750),
    (373,2688)
]

# 最大允许离轨距离

MAX_LINE_DISTANCE = 1

# s范围放宽

S_MARGIN = 3


# =====================================================
# 高斯拟合
# =====================================================

def gauss_1d(x,A,mu,sigma,B):

    return (
        A*np.exp(
            -0.5*((x-mu)/sigma)**2
        ) + B
    )


def fit_gauss_center(line):

    x = np.arange(
        len(line),
        dtype=float
    )

    try:

        mu0 = np.sum(
            x*line
        ) / np.sum(line)

        p0 = [
            line.max()-line.min(),
            mu0,
            2.0,
            line.min()
        ]

        popt,_ = curve_fit(
            gauss_1d,
            x,
            line,
            p0=p0,
            maxfev=1000
        )

        return popt[1]

    except:

        return center_of_mass(line)[0]


# =====================================================
# 数据库
# =====================================================

print("读取数据库...")

db = np.load(
    database_file,
    allow_pickle=True
)

x_ref = db["x_ref"]
y_ref = db["y_ref"]

centers = db["centers"]
directions = db["directions"]

coeffs = db["coeffs"]

s_min = db["s_min"]
s_max = db["s_max"]

N = len(x_ref)

print(f"数据库光斑数: {N}")


# =====================================================
# 读取样品图
# =====================================================

print("读取样品图...")

img = imageio.imread(
    sample_file
)

gray = img[:,:,0].astype(
    np.float32
)

for x,y in BAD_PIXELS:

    roi = gray[
        y-1:y+2,
        x-1:x+2
    ]

    gray[y,x] = (
        np.sum(roi)-gray[y,x]
    ) / 8

H,W = gray.shape


# =====================================================
# 检测光斑
# =====================================================

print("检测光斑...")

coords = peak_local_max(
    gray,
    min_distance=min_distance,
    threshold_abs=threshold_abs
)

M = len(coords)

print(
    f"检测到 {M} 个光斑"
)


# =====================================================
# 亚像素定位
# =====================================================

print("亚像素定位...")

xm_list = []
ym_list = []

for y0,x0 in coords:

    y1 = max(
        int(y0)-roi_radius,
        0
    )

    y2 = min(
        int(y0)+roi_radius+1,
        H
    )

    x1 = max(
        int(x0)-roi_radius,
        0
    )

    x2 = min(
        int(x0)+roi_radius+1,
        W
    )

    roi = gray[
        y1:y2,
        x1:x2
    ]

    if roi.size == 0:
        continue

    dx = fit_gauss_center(
        roi.sum(axis=0)
    )

    dy = fit_gauss_center(
        roi.sum(axis=1)
    )

    xm_list.append(
        x1+dx
    )

    ym_list.append(
        y1+dy
    )

xm = np.array(
    xm_list
)

ym = np.array(
    ym_list
)

M = len(xm)

print(
    f"有效光斑 {M}"
)


# =====================================================
# 轨迹匹配
# =====================================================

print("开始匹配...")

X = []
Y = []
Z = []

matched = 0

for i in range(M):

    x = xm[i]
    y = ym[i]

    dx = x - centers[:,0]
    dy = y - centers[:,1]

    vx = directions[:,0]
    vy = directions[:,1]

    dist = np.abs(
        dx*(-vy)
        +
        dy*(vx)
    )

    idx = np.argmin(
        dist
    )

    dmin = dist[idx]

    if dmin > MAX_LINE_DISTANCE:
        continue

    s = (
        dx[idx]*vx[idx]
        +
        dy[idx]*vy[idx]
    )

    if (
        s <
        s_min[idx]-S_MARGIN
    ):
        continue

    if (
        s >
        s_max[idx]+S_MARGIN
    ):
        continue

    z = np.polyval(
        coeffs[idx],
        s
    )

    X.append(
        x_ref[idx]
    )

    Y.append(
        y_ref[idx]
    )

    Z.append(z)

    matched += 1

    if (i+1) % 1000 == 0:

        print(
            f"{i+1}/{M}"
        )


print()

print(
    f"匹配成功: {matched}"
)

print(
    f"匹配率: "
    f"{100*matched/M:.2f}%"
)


# =====================================================
# 保存点云
# =====================================================

X = np.array(X)
Y = np.array(Y)
Z = np.array(Z)

cloud = np.column_stack(
    [X,Y,Z]
)

np.savetxt(
    "point_cloud.xyz",
    cloud,
    fmt="%.6f"
)

print(
    "已保存 point_cloud.xyz"
)


# =====================================================
# 绘图
# =====================================================

print("绘制点云...")

fig = plt.figure(
    figsize=(10,8)
)

ax = fig.add_subplot(
    111,
    projection='3d'
)

ax.scatter(
    X,
    Y,
    Z,
    s=1
)

ax.set_xlabel(
    "X(pixel)"
)

ax.set_ylabel(
    "Y(pixel)"
)

ax.set_zlabel(
    "Height(mm)"
)

plt.tight_layout()

plt.show()
