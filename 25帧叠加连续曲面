# =====================================================
# 高斯拟合
# =====================================================

def gauss_1d(x,A,mu,sigma,B):

    return A*np.exp(
        -0.5*((x-mu)/sigma)**2
    )+B


def fit_gauss_center(line):

    x=np.arange(
        len(line),
        dtype=float
    )

    try:

        mu0=np.sum(
            x*line
        )/np.sum(line)

        p0=[
            line.max()-line.min(),
            mu0,
            2.0,
            line.min()
        ]

        p,_=curve_fit(
            gauss_1d,
            x,
            line,
            p0=p0,
            maxfev=1000
        )

        return p[1]

    except:

        return center_of_mass(line)[0]


def fit_centroid(line):

    x = np.arange(
        len(line),
        dtype=float
    )

    s = np.sum(line)

    if s <= 0:
        return center_of_mass(line)[0]

    return np.sum(
        x * line
    ) / s


def fit_local_centroid(
        line,
        half_width=2
):

    peak = np.argmax(line)

    left = max(
        peak-half_width,
        0
    )

    right = min(
        peak+half_width+1,
        len(line)
    )

    roi = line[left:right]

    x = np.arange(
        left,
        right,
        dtype=float
    )

    s = np.sum(roi)

    if s <= 0:

        return center_of_mass(line)[0]

    return np.sum(
        x*roi
    )/s


