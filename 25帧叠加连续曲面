def reconstruct_one_frame(sample_file):



    img=imageio.imread(sample_file)
    gray=img[:,:,0].astype(np.float32)


    bg=imageio.imread(background_file)
    background=bg[:,:,0].astype(np.float32)

    for x,y in BAD_PIXELS:

        roi=gray[
            y-1:y+2,
            x-1:x+2
        ]

        gray[y,x]=(
            np.sum(roi)-gray[y,x]
        )/8

    for x,y in BAD_PIXELS:

        roi=background[
            y-1:y+2,
            x-1:x+2
        ]

        background[y,x]=(
            np.sum(roi)-background[y,x]
        )/8

    gray = gray - background

    gray[gray < 0] = 0

    H,W=gray.shape


    # =====================================================
    # 光斑检测
    # =====================================================


    coords=peak_local_max(
        gray,
        min_distance=min_distance,
        threshold_abs=threshold_abs
    )


    xm=[]
    ym=[]


    for y0,x0 in coords:

        y1=max(
            int(y0)-roi_radius,
            0
        )

        y2=min(
            int(y0)+roi_radius+1,
            H
        )

        x1=max(
            int(x0)-roi_radius,
            0
        )

        x2=min(
            int(x0)+roi_radius+1,
            W
        )

        roi=gray[
            y1:y2,
            x1:x2
        ]

        if roi.size==0:
            continue

        profile_x = roi.sum(axis=0)
        profile_y = roi.sum(axis=1)

        if PEAK_METHOD == "gaussian":

            dx = fit_gauss_center(profile_x)
            dy = fit_gauss_center(profile_y)

        elif PEAK_METHOD == "centroid":

            dx = fit_centroid(profile_x)
            dy = fit_centroid(profile_y)

        elif PEAK_METHOD == "local_centroid":

            dx = fit_local_centroid(
                profile_x,
                LOCAL_HALF_WIDTH
            )

            dy = fit_local_centroid(
                profile_y,
                LOCAL_HALF_WIDTH
            )

        else:

            raise ValueError(
                "Unknown PEAK_METHOD"
            )
        
        xm.append(
            x1+dx
        )

        ym.append(
            y1+dy
        )

    xm=np.array(xm)
    ym=np.array(ym)

    M=len(xm)



    # =====================================================
    # 匹配
    # =====================================================



    Z_detect = np.full(N, np.nan)

    X=[]
    Y=[]
    Z=[]

    # 调试信息
    spot_id=[]


    for k in range(N):

        cx,cy=centers[k]

        vx,vy=directions[k]

        nx=-vy
        ny=vx

        dx=xm-cx
        dy=ym-cy

        s=(
            dx*vx
            +
            dy*vy
        )

        d=(
            dx*nx
            +
            dy*ny
        )

        mask=(
            (np.abs(s)<=TRACK_HALF_LENGTH)
            &
            (np.abs(d)<=TRACK_HALF_WIDTH)
        )

        idx=np.where(mask)[0]

        if len(idx)==0:
            continue

        best=idx[
            np.argmin(
                np.abs(d[idx])
            )
        ]


        
        s_peak=s[best]

        coef=coeffs[k]

        z=np.polyval(
            coef,
            s_peak
        )

        Z_detect[k] = z

        X.append(
            x_ref[k]
        )

        Y.append(
            y_ref[k]
        )

        Z.append(z)

        # 调试信息
        spot_id.append(k)




    
    # =====================================================
    # 删除高度离群点
    # =====================================================

    OUTLIER_THRESHOLD = 0.7   # mm

    # 只统计有效点
    X=np.array(X)
    Y=np.array(Y)
    Z=np.array(Z)

    valid=np.isfinite(Z)

    # 使用中位数，比平均值稳定
    z_center = np.median(Z[valid])

    # 判断离群点
    spot_id = np.array(spot_id)

    outlier = np.abs(
        Z - z_center
    ) > OUTLIER_THRESHOLD

    print(f"检测到离群点：{np.sum(outlier)} 个")

    bad_index = spot_id[outlier]

    Z_detect[bad_index] = np.nan

    return Z_detect


