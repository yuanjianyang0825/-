GRID_STEP = 6      # 可以改1、2、3

xi = np.arange(xmin, xmax, GRID_STEP)
yi = np.arange(ymin, ymax, GRID_STEP)

grid_x, grid_y = np.meshgrid(xi, yi)



tree=cKDTree(
np.column_stack(
(
X_total,
Y_total
)
)
)

grid_z=np.full(
    grid_x.shape,
    np.nan
)

rows, cols = grid_x.shape

for r in range(rows):

    print(f"\rIDW:{r+1}/{rows}", end="")

    for c in range(cols):

        pt = np.array([
            grid_x[r,c],
            grid_y[r,c]
        ])

        


        dist,idx=tree.query(
            pt,
            k=IDW_NEIGHBORS,
            distance_upper_bound=IDW_RADIUS
        )

        dist=np.atleast_1d(dist)
        idx=np.atleast_1d(idx)

        valid=np.isfinite(dist)

        valid &= idx < len(Z_total)

        if np.sum(valid)==0:

            grid_z[r,c]=np.nan
            continue

        dist=dist[valid]
        idx=idx[valid]

        dist=np.maximum(
            dist,
            1e-6
        )

        w=1/dist**IDW_POWER

        w/=w.sum()

        grid_z[r,c]=np.sum(
            w*Z_total[idx]
        )



valid=np.isfinite(grid_z)

