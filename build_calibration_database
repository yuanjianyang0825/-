"""
build_calibration_database.py
光谱共焦标定数据库生成（最终版）
"""

import os
import glob
import numpy as np
import imageio.v2 as imageio

from scipy.optimize import curve_fit
from scipy.ndimage import center_of_mass
from skimage.feature import peak_local_max
from numpy.polynomial import Polynomial


# =====================================================
# 配置
# =====================================================

calib_dir = r"C:\Users\A\Desktop\a标定用"

heights_mm = np.linspace(2.5, 0, 26)

roi_radius = 8

threshold_abs = 35
min_distance = 20

BAD_PIXELS = [
    (1207, 2750),
    (373, 2688)
]

MAX_OFFLINE_DIST = 0.5


# =====================================================
# 高斯拟合
# =====================================================

def gauss_1d(x, A, mu, sigma, B):
    return A * np.exp(
        -0.5 * ((x - mu) / sigma) ** 2
    ) + B


def fit_gauss_center(line):

    x = np.arange(
        len(line),
        dtype=float
    )

    try:

        mu0 = np.sum(
            x * line
        ) / np.sum(line)

        p0 = [
            line.max() - line.min(),
            mu0,
            2.0,
            line.min()
        ]

        popt, _ = curve_fit(
            gauss_1d,
            x,
            line,
            p0=p0,
            maxfev=1000
        )

        return popt[1]

    except:

        return center_of_mass(line)[0]


# =====================================================
# PCA直线拟合
# =====================================================

def fit_line_pca(x, y):

    valid = ~(
        np.isnan(x) |
        np.isnan(y)
    )

    x = x[valid]
    y = y[valid]

    if len(x) < 5:
        return None

    pts = np.column_stack(
        (x, y)
    )

    center = pts.mean(axis=0)

    pts0 = pts - center

    _, _, vt = np.linalg.svd(
        pts0,
        full_matrices=False
    )

    direction = vt[0]

    vx, vy = direction

    normal = np.array([
        -vy,
        vx
    ])

    d = np.abs(
        pts0 @ normal
    )

    maxdist = np.max(d)

    angle_deg = np.degrees(
        np.arctan2(vx, vy)
    )

    return (
        center,
        direction,
        angle_deg,
        maxdist
    )


# =====================================================
# 读取图像
# =====================================================

print("\n读取标定图像...")

files = sorted(
    glob.glob(
        os.path.join(
            calib_dir,
            "*.bmp"
        )
    ),
    key=lambda p:
    int(
        os.path.splitext(
            os.path.basename(p)
        )[0]
    )
)

if len(files) != 26:
    raise ValueError(
        f"检测到 {len(files)} 张图像，预期26张"
    )

imgs = []

for idx, f in enumerate(files):

    g = imageio.imread(
        f
    )[:, :, 0].astype(np.float32)

    for x, y in BAD_PIXELS:

        roi = g[
            y-1:y+2,
            x-1:x+2
        ]

        g[y, x] = (
            np.sum(roi) - g[y, x]
        ) / 8

    imgs.append(g)

    print(
        f"\r读取 {idx+1}/26",
        end=""
    )

imgs = np.stack(imgs)

n_frames, H, W = imgs.shape

print("\n完成")


# =====================================================
# 第一帧检测光斑
# =====================================================

print("\n检测参考光斑...")

coords = peak_local_max(
    imgs[0],
    min_distance=min_distance,
    threshold_abs=threshold_abs
)

N = len(coords)

print(
    f"检测到 {N} 个光斑"
)


# =====================================================
# 追踪
# =====================================================

xs = np.full(
    (N, n_frames),
    np.nan,
    np.float32
)

ys = np.full(
    (N, n_frames),
    np.nan,
    np.float32
)

peak_refs = np.full(
    N,
    np.nan,
    np.float32
)

print("\n参考帧亚像素定位...")

for k, (y0, x0) in enumerate(coords):

    y1 = max(
        int(y0)-roi_radius,
        0
    )
    y2 = min(
        int(y0)+roi_radius+1,
        H
    )

    x1 = max(
        int(x0)-roi_radius,
        0
    )
    x2 = min(
        int(x0)+roi_radius+1,
        W
    )

    roi = imgs[0,
               y1:y2,
               x1:x2]

    dx = fit_gauss_center(
        roi.sum(axis=0)
    )

    dy = fit_gauss_center(
        roi.sum(axis=1)
    )

    xs[k, 0] = x1 + dx
    ys[k, 0] = y1 + dy

    peak_refs[k] = np.max(
        roi
    )

print("完成")


print("\n追踪26帧...")

for i in range(1, n_frames):

    for k in range(N):

        if np.isnan(xs[k, i-1]):
            continue

        x = xs[k, i-1]
        y = ys[k, i-1]

        y1 = max(
            int(y)-roi_radius,
            0
        )
        y2 = min(
            int(y)+roi_radius+1,
            H
        )

        x1 = max(
            int(x)-roi_radius,
            0
        )
        x2 = min(
            int(x)+roi_radius+1,
            W
        )

        roi = imgs[
            i,
            y1:y2,
            x1:x2
        ]

        if roi.size == 0:
            continue

        dx = fit_gauss_center(
            roi.sum(axis=0)
        )

        dy = fit_gauss_center(
            roi.sum(axis=1)
        )

        xs[k, i] = x1 + dx
        ys[k, i] = y1 + dy

    print(
        f"\r{i+1}/26",
        end=""
    )

print("\n完成")


# =====================================================
# 建库
# =====================================================

print("\n生成数据库...")

x_ref = []
y_ref = []

centers = []
directions = []
angles = []

coeffs = []

smins = []
smaxs = []

track_lengths = []

fit_rms = []

peak_ref_keep = []

removed = 0

for k in range(N):

    result = fit_line_pca(
        xs[k],
        ys[k]
    )

    if result is None:
        removed += 1
        continue

    center, direction, angle_deg, maxdist = result

    if maxdist > MAX_OFFLINE_DIST:
        removed += 1
        continue

    vx, vy = direction

    s = (
        (xs[k]-center[0])*vx
        +
        (ys[k]-center[1])*vy
    )

    # 统一方向
    if np.nanmean(
        np.diff(s)
    ) < 0:
        s = -s

    p = Polynomial.fit(
        s,
        heights_mm,
        3
    )

    rms = np.std(
        heights_mm -
        p(s)
    )

    x_ref.append(xs[k, 0])
    y_ref.append(ys[k, 0])

    centers.append(center)
    directions.append(direction)

    angles.append(angle_deg)

    coeffs.append(
        p.convert().coef[::-1]
    )

    smins.append(
        np.nanmin(s)
    )

    smaxs.append(
        np.nanmax(s)
    )

    track_lengths.append(
        np.nanmax(s)
        -
        np.nanmin(s)
    )

    fit_rms.append(rms)

    peak_ref_keep.append(
        peak_refs[k]
    )


# =====================================================
# 保存
# =====================================================

np.savez(
    "spot_database.npz",

    x_ref=np.array(x_ref),
    y_ref=np.array(y_ref),

    centers=np.array(centers),
    directions=np.array(directions),

    angle_deg=np.array(angles),

    coeffs=np.array(coeffs),

    s_min=np.array(smins),
    s_max=np.array(smaxs),

    track_length=np.array(track_lengths),

    peak_ref=np.array(peak_ref_keep),

    fit_rms=np.array(fit_rms)
)

# =====================================================
# 统计
# =====================================================

print("\n")
print("="*60)

print(f"原始光斑数: {N}")
print(f"有效光斑数: {len(x_ref)}")
print(f"剔除光斑数: {removed}")

print(
    f"保留比例: "
    f"{100*len(x_ref)/N:.2f}%"
)

print()

print(
    f"平均轨迹长度: "
    f"{np.mean(track_lengths):.2f} pixel"
)

print(
    f"轨迹长度标准差: "
    f"{np.std(track_lengths):.2f} pixel"
)

print()

print(
    f"平均运动角度: "
    f"{np.mean(angles):.4f}°"
)

print(
    f"角度标准差: "
    f"{np.std(angles):.4f}°"
)

print()

print(
    f"平均拟合RMS: "
    f"{1000*np.mean(fit_rms):.3f} μm"
)

print(
    f"最大拟合RMS: "
    f"{1000*np.max(fit_rms):.3f} μm"
)

print()

print(
    f"平均参考灰度: "
    f"{np.mean(peak_ref_keep):.1f}"
)

print("="*60)

print(
    "\n数据库保存成功："
)

print(
    "spot_database.npz"
)
