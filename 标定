"""
build_calibration_database.py
光谱共焦标定数据库生成
#### 存了误差补偿数据
"""

import os
import glob
import numpy as np
import imageio.v2 as imageio

from scipy.optimize import curve_fit
from scipy.ndimage import center_of_mass
from skimage.feature import peak_local_max
from numpy.polynomial import Polynomial

# =====================================================
# 参数
# =====================================================

calib_dir = r"C:\Users\A\Desktop\标定图集"
dark_image_path = r"C:\Users\A\Desktop\Image-Captured-At10-17-18-02-56\1.bmp"
heights_mm = np.linspace(2.7, 0, 28)
roi_radius_x = 3   # x方向ROI半径
roi_radius_y = 5   # y方向ROI半径
threshold_abs = 35
min_distance = 20
MAX_OFFLINE_DISTANCE = 0.5

# 单个光斑最大残差阈值：超过 5 um 就剔除该光斑
# 5 um = 0.005 mm
MAX_SPOT_ERROR_MM = 0.005

# =====================================================
# 读取暗背景
# =====================================================
dark = imageio.imread(dark_image_path)[:, :, 0].astype(np.float32)

# =====================================================
# 高斯拟合
# =====================================================

def gauss_1d(x, A, mu, sigma, B):
    return A * np.exp(
        -0.5 * ((x - mu) / sigma) ** 2
    ) + B


def fit_gauss_center(line):
    """
    对一维投影曲线进行高斯拟合，返回亚像素中心位置
    采用自适应 sigma 初猜（加权标准差）
    """
    x = np.arange(len(line), dtype=float)
    total = np.sum(line)
    
    # 防呆处理：如果总强度为0，直接返回质心（或中点）作为保底
    if total == 0:
        return len(line) / 2.0

    try:
        # 1. 质心法计算 mu 初猜
        mu0 = np.sum(x * line) / total
        
        # 2. ===== 核心改动：自适应计算 sigma 初猜 =====
        # 计算加权二阶中心矩（即加权标准差）
        sigma0 = np.sqrt(np.sum(line * (x - mu0) ** 2) / total)
        
        # 3. 安全保护：防止 sigma 极瘦（<0.1px）或极胖（>10px）或出现 NaN
        if not np.isfinite(sigma0) or sigma0 < 0.1 or sigma0 > 10:
            sigma0 = 2.0  # 极端情况下的保底值
        
        # 4. 构造初猜参数 [振幅, 中心, 标准差, 背景]
        p0 = [
            line.max() - line.min(),
            mu0,
            sigma0,          # 这里不再是固定的 2.0
            line.min()
        ]

        # 5. 执行高斯拟合
        popt, _ = curve_fit(
            gauss_1d,
            x,
            line,
            p0=p0,
            maxfev=1000
        )
        return popt[1]  # 返回拟合出的中心 mu

    except Exception:
        # 如果拟合失败，退回到质心法（一阶矩）
        return center_of_mass(line)[0]


# =====================================================
# 自动选阶
# =====================================================

def fit_order(
        s,
        z,
        max_order=4,
        rmse_threshold=0.001):
    """
    自动选择 z=f(s) 的多项式阶数

    目标：
    选择最低阶多项式，使拟合RMSE <= 1um

    参数:
    s: 光斑位移(pixel)
    z: 高度(mm)

    rmse_threshold:
        RMSE阈值(mm)
        0.001 mm = 1 um
    """

    valid = ~np.isnan(s)

    s = s[valid]
    z = z[valid]


    best_deg = max_order


    for deg in range(1, max_order+1):

        p = Polynomial.fit(
            s,
            z,
            deg
        )


        residual = z - p(s)


        rmse = np.sqrt(
            np.mean(
                residual**2
            )
        )


        # 如果当前阶数已经满足1um要求
        if rmse <= rmse_threshold:

            best_deg = deg

            break


    return best_deg


# =====================================================
# PCA拟合运动方向
# =====================================================

def fit_line_pca(x, y):

    valid = ~(
        np.isnan(x)
        |
        np.isnan(y)
    )

    if np.sum(valid) < 3:
        return None

    pts = np.column_stack(
        (
            x[valid],
            y[valid]
        )
    )

    center = pts.mean(
        axis=0
    )

    pts_centered = (
        pts - center
    )

    _, _, vt = np.linalg.svd(
        pts_centered,
        full_matrices=False
    )

    direction = vt[0]

    vx, vy = direction

    normal = np.array(
        [-vy, vx]
    )

    distances = np.abs(
        pts_centered @ normal
    )

    max_distance = np.max(
        distances
    )

    return (
        center,
        direction,
        max_distance
    )


# =====================================================
# 读取图像
# =====================================================
# 读取标定图像（每帧减去暗背景）
# =====================================================
print("\n==============================")
print("读取标定图像")
print("==============================")

files = sorted(
    glob.glob(os.path.join(calib_dir, "*.bmp")),
    key=lambda p: int(os.path.splitext(os.path.basename(p))[0])
)

if len(files) != 28:
    raise ValueError(f"必须恰好有 28 张标定图，当前检测到 {len(files)} 张")

imgs = []
for idx, f in enumerate(files):
    g = imageio.imread(f)[:, :, 0].astype(np.float32)

    # 减去暗背景（若存在）
    if dark is not None:
        g = g - dark
        g = np.clip(g, 0, None)   # 避免负值影响拟合

    imgs.append(g)

    if (idx + 1) % 5 == 0 or idx == len(files)-1:
        print(f"已读取 {idx+1}/{len(files)}")

imgs = np.stack(imgs)
n_frames, H, W = imgs.shape
print(f"\n图像尺寸: {W} × {H}")
print(f"标定帧数: {n_frames}")


# =====================================================
# 第一帧检测
# =====================================================

print("\n检测参考帧光斑...")

coords = peak_local_max(
    imgs[0],
    min_distance=min_distance,
    threshold_abs=threshold_abs
)

N = len(coords)

print(
    f"检测到 {N} 个光斑"
)

xs = np.full(
    (N, n_frames),
    np.nan,
    dtype=np.float32
)

ys = np.full(
    (N, n_frames),
    np.nan,
    dtype=np.float32
)

# =====================================================
# 第一帧亚像素定位
# =====================================================

print(
    "\n参考帧亚像素定位..."
)

for k, (y0, x0) in enumerate(coords):

    y1 = max(
        int(y0)-roi_radius_y,
        0
    )

    y2 = min(
        int(y0)+roi_radius_y+1,
        H
    )

    x1 = max(
        int(x0)-roi_radius_x,
        0
    )

    x2 = min(
        int(x0)+roi_radius_x+1,
        W
    )

    roi = imgs[
        0,
        y1:y2,
        x1:x2
    ]

    dx = fit_gauss_center(
        roi.sum(axis=0)
    )

    dy = fit_gauss_center(
        roi.sum(axis=1)
    )

    xs[k, 0] = x1 + dx
    ys[k, 0] = y1 + dy

# =====================================================
# 26帧追踪
# =====================================================

print(
    "\n开始追踪30帧..."
)

for i in range(1, n_frames):

    for k in range(N):

        if np.isnan(
            xs[k, i-1]
        ):
            continue

        x = xs[k, i-1]
        y = ys[k, i-1] - 3

        y1 = max(
            int(y)-roi_radius_y,
            0
        )

        y2 = min(
            int(y)+roi_radius_y+1,
            H
        )

        x1 = max(
            int(x)-roi_radius_x,
            0
        )

        x2 = min(
            int(x)+roi_radius_x+1,
            W
        )

        roi = imgs[
            i,
            y1:y2,
            x1:x2
        ]

        if roi.size == 0:
            continue

        xs[k, i] = (
            x1 +
            fit_gauss_center(
                roi.sum(axis=0)
            )
        )

        ys[k, i] = (
            y1 +
            fit_gauss_center(
                roi.sum(axis=1)
            )
        )

    print(
        f"完成 {i+1}/{n_frames} 帧"
    )

# =====================================================
# 建立数据库
# =====================================================

print(
    "\n开始建立标定数据库..."
)

x_ref = []
y_ref = []

centers = []
directions = []

coeffs = []
orders = []

smins = []
smaxs = []

max_dists = []

spot_ids = []

xs_valid = []
ys_valid = []

errors = []
s_values = []

rejected_by_error = 0

for k in range(N):

    result = fit_line_pca(
        xs[k],
        ys[k]
    )

    if result is None:
        continue

    center, direction, maxdist = result

    if maxdist > MAX_OFFLINE_DISTANCE:
        continue

    vx, vy = direction

    s = (
        (xs[k]-center[0])*vx
        +
        (ys[k]-center[1])*vy
    )

    valid = ~np.isnan(s)

    if np.sum(valid) < 10:
        continue

    deg = fit_order(
        s,
        heights_mm
    )

    p = Polynomial.fit(
        s[valid],
        heights_mm[valid],
        deg
    )



    # =================================================
    # 计算标定残差误差
    # =================================================

    z_fit = p(s[valid])

    error = heights_mm[valid] - z_fit


    # 保存该spot的26个高度误差
    error_full = np.full(
        n_frames,
        np.nan
    )

    error_full[valid] = error

    # =================================================
    # 按单光斑最大残差剔除
    # =================================================
    if np.any(np.isfinite(error_full)):
        spot_max_error = np.nanmax(np.abs(error_full))
    else:
        spot_max_error = np.inf

    if spot_max_error > MAX_SPOT_ERROR_MM:
        # 该光斑误差超阈值，直接跳过，不加入数据库
        print(f"spot {k} 最大误差 {spot_max_error*1000:.2f} um，剔除")
        rejected_by_error += 1
        continue

    # =================================================
    # 保存s
    # =================================================
    s_values.append(s.copy())


    errors.append(
        error_full
    )
    
    x_ref.append(xs[k,0])
    y_ref.append(ys[k,0])              #光斑第一帧的参考坐标

    xs_valid.append(xs[k].copy())
    ys_valid.append(ys[k].copy())      #光斑原始的26帧数轨迹

    centers.append(center)
    directions.append(direction)

    coeffs.append(
        p.convert().coef[::-1]
    )

    orders.append(deg)

    smins.append(
        np.nanmin(s)
    )

    smaxs.append(
        np.nanmax(s)
    )

    max_dists.append(
        maxdist
    )

    spot_ids.append(k)

    if (k+1) % 1000 == 0:

        print(
            f"已处理 {k+1}/{N}"
        )

# =====================================================
# 保存
# =====================================================

np.savez(
    "spot_database.npz",

    x_ref=np.array(x_ref),
    y_ref=np.array(y_ref),

    centers=np.array(centers),
    directions=np.array(directions),

    coeffs=np.array(
        coeffs,
        dtype=object
    ),

    orders=np.array(
        orders
    ),

    s_min=np.array(
        smins
    ),

    s_max=np.array(
        smaxs
    ),

    max_distances=np.array(
        max_dists
    ),

    spot_id=np.array(
        spot_ids
    ),

    xs=xs,
    ys=ys,

    xs_valid=np.array(xs_valid),
    ys_valid=np.array(ys_valid),

    errors=np.array(errors),

    s_values=np.array(s_values, dtype=np.float32),   # 新增

    
    heights=heights_mm

    
)

# =====================================================
# 统计
# =====================================================

valid_num = len(x_ref)

print("\n========================================")

print(
    f"原始光斑数: {N}"
)

print(
    f"有效光斑数: {valid_num}"
)

print(
    f"剔除光斑数: {N-valid_num}"
)

print(
    f"保留比例: "
    f"{valid_num/N*100:.2f}%"
)

print(
    f"平均最大离线距离: "
    f"{np.mean(max_dists):.4f} pixel"
)

print(
    f"最大离线距离: "
    f"{np.max(max_dists):.4f} pixel"
)

print(
    "\n数据库保存成功："
)

print(
    "spot_database.npz"
)

errors = np.array(errors)


valid_error = errors[np.isfinite(errors)]


rms_error = np.sqrt(
    np.mean(valid_error**2)
)


max_error = np.max(
    np.abs(valid_error)
)


print(
    f"\n整体标定RMS误差: "
    f"{rms_error*1000:.3f} um"
)


print(
    f"整体最大误差: "
    f"{max_error*1000:.3f} um"
)

print(
    f"因最大误差>5um剔除的光斑数: {rejected_by_error}"
)

print("========================================")

